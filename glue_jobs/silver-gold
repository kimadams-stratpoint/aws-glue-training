from __future__ import annotations

import sys
from awsglue.context import GlueContext
from awsglue.job import Job
from awsglue.utils import getResolvedOptions
from pyspark.context import SparkContext
from pyspark.sql import SparkSession
from pyspark.sql import functions as F
from pyspark.sql.types import (
    DoubleType,
    LongType,
    StringType,
    StructField,
    StructType,
    TimestampType,
)

# -------------------------------------------------------------------------
# 1. INITIALIZATION & ARGS PARSING
# -------------------------------------------------------------------------
args = getResolvedOptions(
    sys.argv,
    [
        "JOB_NAME",
        "BASE_S3_BUCKET",
        "SILVER_FOLDER",
        "QUARANTINE_FOLDER",
        "AUDIT_FOLDER",
        "GOLD_DB_NAME",
    ],
)

sc = SparkContext()
glue_context = GlueContext(sc)
spark = glue_context.spark_session
job = Job(glue_context)
logger = glue_context.get_logger()

# Standardize path slashes dynamically
base_bucket = args["BASE_S3_BUCKET"].rstrip("/")
SILVER_INPUT_PATH = f"{base_bucket}/{args['SILVER_FOLDER'].lstrip('/')}"
QUARANTINE_INPUT_PATH = f"{base_bucket}/{args['QUARANTINE_FOLDER'].lstrip('/')}"
AUDIT_OUTPUT_PATH = f"{base_bucket}/{args['AUDIT_FOLDER'].lstrip('/')}"

DATABASE_NAME = args["GOLD_DB_NAME"]
GOLD_TABLE_NAME = "certified_finance_revenue"


# -------------------------------------------------------------------------
# 2. BUSINESS LOGIC & TRANSFORMATIONS
# -------------------------------------------------------------------------
def build_gold_metrics(silver_df):
    """
    Computes business metrics and daily financial summaries from the Silver layer.
    Filters specifically for purchase events to accurately calculate financial revenue.
    """
    # Filter for completed sales events to calculate actual financials
    purchase_df = silver_df.filter(F.col("event_type_clean") == "purchase")

    gold_metrics = (
        purchase_df.withColumn("event_date", F.col("event_time_ts").cast("date"))
        .groupBy(F.col("event_date"), F.col("category_code_clean").alias("category_code"))
        .agg(
            F.round(F.sum("price"), 2).alias("total_revenue"),
            F.count("product_id").alias("purchase_count"),
            F.countDistinct("user_id").alias("unique_users"),
        )
        .withColumn("year", F.year("event_date"))
        .withColumn("month", F.month("event_date"))
    )
    return gold_metrics


def build_quality_audit(spark_session, batch_id, total, valid, quarantined):
    """
    Generates operational health metrics and audit lineage metadata.
    """
    health_score = (valid / total * 100.0) if total > 0 else 100.0

    audit_schema = StructType([
        StructField("batch_id", StringType(), False),
        StructField("execution_timestamp", TimestampType(), True),
        StructField("total_records_processed", LongType(), False),
        StructField("valid_records_count", LongType(), False),
        StructField("quarantined_records_count", LongType(), False),
        StructField("data_health_score", DoubleType(), False),
    ])

    audit_data = [(
        batch_id,
        None,
        int(total),
        int(valid),
        int(quarantined),
        float(health_score),
    )]

    raw_audit_df = spark_session.createDataFrame(audit_data, schema=audit_schema)
    return raw_audit_df.withColumn("execution_timestamp", F.current_timestamp())


# -------------------------------------------------------------------------
# 3. MAIN EXECUTION PIPELINE
# -------------------------------------------------------------------------
def main() -> None:
    job.init(args["JOB_NAME"], args)

    # Resolve active AWS Glue Job Run ID for audit tracing
    job_run_id = "unknown_run"
    if "--JOB_RUN_ID" in sys.argv:
        job_run_id = sys.argv[sys.argv.index("--JOB_RUN_ID") + 1]

    GOLD_BATCH_ID = job_run_id
    logger.info(f"Starting Silver-to-Gold Pipeline for Batch ID: {GOLD_BATCH_ID}")

    # Step 1: Read Silver Layer (Valid Records)
    logger.info(f"Reading Silver layer from: {SILVER_INPUT_PATH}")
    silver_df = spark.read.parquet(SILVER_INPUT_PATH).cache()

    # Step 2: Gracefully evaluate Quarantine metadata for lineage tracking
    try:
        quarantine_df = spark.read.parquet(QUARANTINE_INPUT_PATH).cache()
        quarantine_records = quarantine_df.count()
        logger.info(f"Quarantine records located: {quarantine_records}")
    except Exception as e:
        logger.warn(f"Unable to read quarantine path: {QUARANTINE_INPUT_PATH}. Defaulting count to 0. Context: {str(e)}")
        quarantine_records = 0

    valid_records = silver_df.count()
    total_records = valid_records + quarantine_records

    logger.info(
        f"Lineage metrics: Total={total_records}, Valid (Silver)={valid_records}, Quarantined={quarantine_records}"
    )

    # Step 3: Compute Gold Aggregations
    logger.info("Computing daily revenue and user engagement metrics...")
    gold_df = build_gold_metrics(silver_df)

    # Step 4: Write to Iceberg Gold Layer
# Step 4: Write to Iceberg Gold Layer
    logger.info(f"Writing aggregated metrics to Iceberg table: {DATABASE_NAME}.{GOLD_TABLE_NAME}")
    
    gold_df.createOrReplaceTempView("temp_gold_metrics")

    # Use fully qualified glue_catalog identifier
    ICEBERG_TABLE_REF = f"glue_catalog.`{DATABASE_NAME}`.`{GOLD_TABLE_NAME}`"

    spark.sql(f"""
        CREATE TABLE IF NOT EXISTS {ICEBERG_TABLE_REF} (
            event_date DATE,
            category_code STRING,
            total_revenue DOUBLE,
            purchase_count BIGINT,
            unique_users BIGINT,
            year INT,
            month INT
        )
        USING iceberg
        PARTITIONED BY (year, month)
    """)

    # Transactional Partition Overwrite
    spark.sql(f"""
        INSERT OVERWRITE {ICEBERG_TABLE_REF}
        SELECT 
            event_date,
            category_code,
            total_revenue,
            purchase_count,
            unique_users,
            year,
            month
        FROM temp_gold_metrics
    """)
    logger.info(f"Successfully updated Iceberg Gold table: {GOLD_TABLE_NAME}")
    
    # Step 5: Publish Pipeline Health Log to Audit Location
    logger.info("Generating data health scores and exporting pipeline logs...")
    audit_df = build_quality_audit(
        spark, GOLD_BATCH_ID, total_records, valid_records, quarantine_records
    )
    
    # Write audit log cleanly via standard Spark Parquet writer
    audit_df.write.mode("append").parquet(AUDIT_OUTPUT_PATH)
    logger.info(f"Pipeline health audit published to: {AUDIT_OUTPUT_PATH}")

    # Step 6: Memory Clean-up
    silver_df.unpersist()
    if "quarantine_df" in locals():
        quarantine_df.unpersist()

    job.commit()
    logger.info("Glue Job completed successfully.")
    spark.stop()


if __name__ == "__main__":
    main()
